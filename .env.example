# Copy to .env, chmod 600 .env, and edit locally. Never commit a real token.
# Use a read-only token from the account approved for the gated models.
HF_TOKEN=

# Run from the repository root, or use absolute paths here.
HF_HOME=./var/hf-cache
HF_HUB_CACHE=./var/hf-cache/hub
HELIOS_MODEL_DIR=./var/models
TORCH_HOME=./var/torch-cache
